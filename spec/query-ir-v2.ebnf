query = "(" , "nlsql" , version , query-body , ")" ;
version = "1" | "2" ;
query-body = "(" , "query" , from-clause , { join-clause } , select-clause , [ where-clause ] , [ group-clause ] , [ order-clause ] , [ limit-clause ] , ")" ;
from-clause = "(" , "from" , identifier , [ identifier ] , ")" ;
join-clause = "(" , "join" , join-type , identifier , [ identifier ] , predicate , ")" ;
join-type = "inner" | "left" | "right" | "full" ;
select-clause = "(" , "select" , field , { field } , ")" ;
field = "(" , "field" , expression , identifier , ")" ;
where-clause = "(" , "where" , expression , ")" ;
group-clause = "(" , "group-by" , expression , { expression } , ")" ;
order-clause = "(" , "order-by" , expression , ("asc" | "desc") , ")" ;
limit-clause = "(" , "limit" , integer , ")" ;
expression = column | parameter | reference | aggregate | window | predicate | arithmetic | boolean | string-op | null-op | coalesce-op ;
window = "(" , "window" , expression , partition-clause , order-clause , ")" ;
partition-clause = "(" , "partition-by" , expression , { expression } , ")" ;
column = "(" , "column" , identifier , identifier , ")" ;
parameter = "(" , "param" , identifier , identifier , ")" ;
reference = "(" , "ref" , identifier , ")" ;
aggregate = "(" , ("sum" | "avg" | "count" | "min" | "max" | "count-distinct" | "sum-distinct") , expression , ")" ;
predicate = "(" , ("eq" | "gte" | "gt" | "lte" | "lt" | "neq") , expression , expression , ")" ;
arithmetic = "(" , ("mul" | "add" | "sub" | "div") , expression , expression , ")" ;
boolean = "(" , ("and" | "or") , expression , expression , { expression } , ")" | "(" , "not" , expression , ")" ;
string-op = "(" , ("lower" | "upper" | "trim" | "abs") , expression , ")" | "(" , "concat" , expression , expression , { expression } , ")" ;
null-op = "(" , ("is-null" | "is-not-null") , expression , ")" ;
coalesce-op = "(" , "coalesce" , expression , expression , { expression } , ")" ;
identifier = letter , { letter | digit | "_" | "." } ;
integer = digit , { digit } ;
letter = "A".."Z" | "a".."z" | "_" ;
digit = "0".."9" ;
